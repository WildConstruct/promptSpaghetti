{
  "name": "server",
  "version": "0.1.0-alpha",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "test": "jest",
    "perf:test": "ts-node src/performance/performance-cli.ts test",
    "perf:monitor": "ts-node src/performance/performance-cli.ts monitor",
    "perf:optimize": "ts-node src/performance/performance-cli.ts optimize",
    "perf:health": "ts-node src/performance/performance-cli.ts health",
    "perf:stress": "ts-node src/performance/performance-cli.ts test --stress",
    "perf:report": "ts-node src/performance/performance-cli.ts report",
    "perf:k6:ci": "ts-node -r tsconfig-paths/register src/performance/k6-integration.ts ci",
    "perf:k6:smoke": "ts-node -r tsconfig-paths/register src/performance/k6-integration.ts smoke",
    "perf:k6:staging": "ts-node -r tsconfig-paths/register src/performance/k6-integration.ts staging",
    "perf:k6:graph": "k6 run server/src/performance/k6-tests/graph-execution-load.js",
    "perf:k6:websocket": "k6 run server/src/performance/k6-tests/websocket-collaboration.js",
    "perf:k6:auth": "k6 run server/src/performance/k6-tests/auth-load.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "commander": "^11.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "@fastify/multipart": "^10.0.0",
    "openai": "^4.0.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "@supabase/supabase-js": "^2.45.4",
    "@sentry/node": "^7.120.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
