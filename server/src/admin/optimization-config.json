  "recommendationTemplates": [
    {
      "templateId": "cache_optimization",
      "category": "performance",
      "priority": "medium",
      "title": "Optimize Caching Strategy",
      "description": "Improve system performance by optimizing caching configuration",
      "expectedImpact": {
        "performanceImprovement": 25,
        "resourceSaving": 15,
        "userExperienceImprovement": 7,
        "implementationEffort": "medium"
      },
      "implementation": {
        "steps": [
          {
            "stepId": "analyze_cache_hit_ratio",
            "order": 1,
            "title": "Analyze current cache hit ratio",
            "description": "Review cache performance metrics",
            "estimatedTime": 15,
            "requiredRole": "system_admin",
            "validation": {
              "metrics": ["cache_hit_ratio"],
              "thresholds": { "cache_hit_ratio": 0.8 },
              "timeout": 300,
              "rollbackOnFailure": false
            }
          },
          {
            "stepId": "adjust_cache_size",
            "order": 2,
            "title": "Adjust cache size and TTL",
            "description": "Optimize cache configuration parameters",
            "estimatedTime": 30,
            "requiredRole": "system_admin",
            "validation": {
              "metrics": ["cache_hit_ratio", "memory_usage"],
              "thresholds": { "cache_hit_ratio": 0.85, "memory_usage": 0.8 },
              "timeout": 600,
              "rollbackOnFailure": true
            }
          },
          {
            "stepId": "monitor_performance",
            "order": 3,
            "title": "Monitor performance impact",
            "description": "Validate optimization effectiveness",
            "estimatedTime": 60,
            "requiredRole": "system_admin",
            "validation": {
              "metrics": ["response_time", "cache_hit_ratio"],
              "thresholds": { "response_time": 200, "cache_hit_ratio": 0.85 },
              "timeout": 3600,
              "rollbackOnFailure": true
            }
          }
        ],
        "estimatedTime": 105,
        "requiredResources": ["system_admin", "monitoring_access"],
        "risks": [
          {
            "riskId": "memory_usage_increase",
            "description": "Cache size increase may impact memory usage",
            "severity": "medium",
            "probability": 0.3,
            "impact": "Increased memory usage may affect other services",
            "mitigation": "Monitor memory usage and adjust cache size if needed"
          }
        ]
      }
    },
    
    {
      "templateId": "database_query_optimization",
      "category": "performance",
      "priority": "high",
      "title": "Optimize Database Queries",
      "description": "Improve database performance by optimizing slow queries",
      "expectedImpact": {
        "performanceImprovement": 40,
        "resourceSaving": 30,
        "userExperienceImprovement": 8,
        "implementationEffort": "high"
      },
      "implementation": {
        "steps": [
          {
            "stepId": "identify_slow_queries",
            "order": 1,
            "title": "Identify slow queries",
            "description": "Analyze database logs for slow queries",
            "estimatedTime": 45,
            "requiredRole": "dba",
            "validation": {
              "metrics": ["query_count"],
              "thresholds": { "query_count": 10 },
              "timeout": 1800,
              "rollbackOnFailure": false
            }
          },
          {
            "stepId": "optimize_queries",
            "order": 2,
            "title": "Optimize identified queries",
            "description": "Add indexes and rewrite inefficient queries",
            "estimatedTime": 120,
            "requiredRole": "dba",
            "validation": {
              "metrics": ["avg_query_time"],
              "thresholds": { "avg_query_time": 100 },
              "timeout": 3600,
              "rollbackOnFailure": true
            },
            "rollbackInstructions": "Remove added indexes and restore original queries"
          }
        ],
        "estimatedTime": 165,
        "requiredResources": ["dba", "database_access", "query_analyzer"],
        "risks": [
          {
            "riskId": "query_performance_regression",
            "description": "Query optimizations may cause performance regression",
            "severity": "high",
            "probability": 0.2,
            "impact": "Some queries may become slower",
            "mitigation": "Test all optimizations in staging environment first"
          }
        ]
      }
    }
  ],
  
