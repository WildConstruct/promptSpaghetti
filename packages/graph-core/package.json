{
  "name": "@prompt-spaghetti/graph-core",
  "version": "0.1.0",
  "description": "Pure TypeScript graph engine with CRDT integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "seedrandom": "^3.0.5",
    "yjs": "^13.6.27",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-jest": "29.4.0",
    "typescript": "^5.0.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}