{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {},
    "types": ["jest", "node"],
    "isolatedModules": true,
    "rootDir": "../.."
  },
  "include": ["src", "types", "scripts/**/*.d.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
