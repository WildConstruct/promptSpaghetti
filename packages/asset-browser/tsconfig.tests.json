{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "jsx": "react-jsx",
    "types": ["jest", "node", "testing-library__jest-dom"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "baseUrl": "."
  },
  "include": ["src", "tests", "scripts/**/*.d.ts", "scripts/**/*.d.cts"]
}
