{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "baseUrl": "."
  },
  "include": [
    "src",
    "tests",
    "scripts/**/*.d.ts",
    "scripts/**/*.d.cts"
  ]
}
