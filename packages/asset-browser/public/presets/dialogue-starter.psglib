          "choices": [
            { "text": "meeting someone new", "weight": 2 },
            { "text": "reuniting after years", "weight": 1 },
            { "text": "confronting a rival", "weight": 1 },
            { "text": "asking for help", "weight": 2 },
            { "text": "delivering bad news", "weight": 1 },
