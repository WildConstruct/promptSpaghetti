      {
        "id": "opener-1736537000001",
        "type": "WeightedChoice",
        "position": { "x": 350, "y": 100 },
        "data": {
          "choices": [
            { "text": "\"I wasn't expecting to see you here.\"", "weight": 2 },
            { "text": "\"We need to talk about what happened.\"", "weight": 1 },
            { "text": "\"I've been thinking about what you said.\"", "weight": 2 },
            { "text": "\"There's something I should have told you.\"", "weight": 1 },
            { "text": "\"I know this is awkward, but...\"", "weight": 2 },
            { "text": "\"You're probably wondering why I called.\"", "weight": 1 },
            { "text": "\"I owe you an explanation.\"", "weight": 1 },
            { "text": "\"Before you say anything, hear me out.\"", "weight": 1 },
            { "text": "\"I didn't think I'd get another chance to say this.\"", "weight": 1 },
            { "text": "\"You look different. Good different.\"", "weight": 1 },
            { "text": "\"I need your help, and you're the only one I trust.\"", "weight": 1 },
            { "text": "\"This isn't easy for me to say.\"", "weight": 2 }
          ]
        },
        "label": "Opening Line"
      },
      {
        "id": "output-1736537000000",
        "type": "Output",
        "position": { "x": 600, "y": 100 },
