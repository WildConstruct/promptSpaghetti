{
  "name": "@promptscape/core",
  "version": "0.1.0-alpha",
  "main": "dist/cjs/public.js",
  "module": "dist/esm/public.js",
  "types": "dist/types/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/esm/public.js",
      "require": "./dist/cjs/public.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    },
    "./utils/*": {
      "types": "./dist/types/utils/*.d.ts",
      "import": "./dist/esm/utils/*.js",
      "require": "./dist/cjs/utils/*.js"
    },
    "./fileFormats/*": {
      "types": "./dist/types/fileFormats/*.d.ts",
      "import": "./dist/esm/fileFormats/*.js",
      "require": "./dist/cjs/fileFormats/*.js"
    },
    "./components/epic1": {
      "types": "./components/epic1/index.d.ts",
      "import": "./components/epic1/index.js",
      "require": "./components/epic1/index.js"
    },
    "./components/epic1/*": {
      "types": "./components/epic1/*.d.ts",
      "import": "./components/epic1/*.js",
      "require": "./components/epic1/*.js"
    },
    "./components/epic1/*.css": "./components/epic1/*.css"
  },
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.esm.json && tsc --project tsconfig.cjs.json && tsc --project tsconfig.types.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "jest",
    "verify:exports": "node scripts/verify-exports.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.54.0",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.53",
    "acorn": "^8.15.0",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "lz-string": "^1.5.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.11",
    "reactflow": "^11.11.4",
    "seedrandom": "^3.0.5",
    "zod": "^4.3.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/lz-string": "^1.5.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/seedrandom": "^2.4.34",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1"
  }
}
