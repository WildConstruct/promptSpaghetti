{
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist"
  },
  "include": [
    "public.ts",
    "utils/index.ts",
    "utils/psgCodec.ts",
    "utils/psgStorage.ts",
    "utils/supabaseClient.ts",
    "utils/supabaseFeature.ts",
    "types/graph.ts",
    "fileFormats/index.ts",
    "runtime/presetInsertion.ts",
    "runtime/nodes/epic1/Epic1ExecutionEngine.ts",
    "components/epic1/**/*.ts",
    "components/epic1/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "**/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "dist"
  ]
}
