{
  "name": "@prompt-spaghetti/ui-kit",
  "version": "0.1.0",
  "description": "Cross-platform React components for graph editing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "typecheck": "echo 'Skipping ui-kit typecheck - package under development'",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:test": "test-storybook"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@prompt-spaghetti/graph-core": "workspace:*",
    "clsx": "^2.0.0",
    "framer-motion": "^10.0.0",
    "react-spring": "^9.7.0",
    "react-use-gesture": "^9.1.3",
    "reactflow": "^11.11.4",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^7.0.0",
    "@storybook/addon-backgrounds": "^7.0.0",
    "@storybook/addon-controls": "^7.0.0",
    "@storybook/addon-docs": "^7.0.0",
    "@storybook/addon-essentials": "^7.0.0",
    "@storybook/addon-interactions": "^7.0.0",
    "@storybook/addon-links": "^7.0.0",
    "@storybook/addon-measure": "^7.0.0",
    "@storybook/addon-outline": "^7.0.0",
    "@storybook/addon-viewport": "^7.0.0",
    "@storybook/react-vite": "^7.0.0",
    "@storybook/test-runner": "^0.23.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.0.0",
    "jest-transform-stub": "^2.0.0",
    "rimraf": "^5.0.0",
    "storybook": "^7.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.0.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}