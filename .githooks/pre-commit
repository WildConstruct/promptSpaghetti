#!/bin/bash

# Pre-commit Quality Gates Hook
# Runs comprehensive quality checks before allowing commits

set -e

echo "🔍 Running pre-commit quality checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    print_status $RED "❌ Error: Not in a git repository"
    exit 1
fi

# Get staged files
STAGED_JS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$' || true)
STAGED_JSON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.json$' || true)

if [ -z "$STAGED_JS_FILES" ] && [ -z "$STAGED_JSON_FILES" ]; then
    print_status $GREEN "✅ No JavaScript/TypeScript files to check"
    exit 0
fi

# Function to run checks and capture results
run_check() {
    local check_name=$1
    local command=$2
    local is_critical=${3:-false}
    
    print_status $YELLOW "🔄 Running $check_name..."
    
    if $command; then
        print_status $GREEN "✅ $check_name passed"
        return 0
    else
        print_status $RED "❌ $check_name failed"
        if [ "$is_critical" = true ]; then
            print_status $RED "💀 Critical check failed - commit blocked"
            exit 1
        fi
        return 1
    fi
}

# Check if node_modules exists
if [ ! -d "node_modules" ]; then
    print_status $YELLOW "⚠️  node_modules not found. Running pnpm install..."
    pnpm install
fi

# Critical checks that block commits
print_status $YELLOW "🚨 Running critical quality checks..."

# 1. TypeScript compilation check
run_check "TypeScript compilation" "npx tsc --noEmit" true

# 2. Security validation
run_check "Security validation" "node scripts/dev-quality-check.js --security-only" true

# 3. Lint check for staged files
if [ ! -z "$STAGED_JS_FILES" ]; then
    run_check "ESLint (staged files)" "npx eslint $STAGED_JS_FILES" true
fi

# Non-critical checks that warn but don't block
print_status $YELLOW "⚠️  Running advisory quality checks..."

# 4. Quality improvement tests (non-blocking)
run_check "Quality improvement tests" "node -e \"
const { runQualityTests, checkPerformanceBaseline } = require('./client/src/utils/__tests__/testRunner.js');

(async () => {
  try {
    const report = await runQualityTests();
    const passedBaseline = checkPerformanceBaseline(report);
    
    if (!passedBaseline) {
      console.warn('⚠️  Performance baseline not met, but not blocking commit');
      return false;
    }
    
    if (report.failedTests > 0) {
      console.warn('⚠️  Some quality tests failed, but not blocking commit');
      return false;
    }
    
    return true;
  } catch (error) {
    console.warn('⚠️  Quality tests could not run:', error.message);
    return false;
  }
})().then(success => process.exit(success ? 0 : 1));
\"" false

# 5. Performance check for large files
if [ ! -z "$STAGED_JS_FILES" ]; then
    print_status $YELLOW "📏 Checking file sizes..."
    for file in $STAGED_JS_FILES; do
        if [ -f "$file" ]; then
            size=$(wc -c < "$file")
            if [ $size -gt 50000 ]; then # 50KB threshold
                print_status $YELLOW "⚠️  Large file detected: $file (${size} bytes)"
                print_status $YELLOW "    Consider splitting this file for better maintainability"
            fi
        fi
    done
fi

# 6. Check for console.log statements (warning only)
if [ ! -z "$STAGED_JS_FILES" ]; then
    print_status $YELLOW "🔍 Checking for console statements..."
    for file in $STAGED_JS_FILES; do
        if [ -f "$file" ]; then
            console_count=$(grep -c "console\." "$file" 2>/dev/null || echo "0")
            if [ $console_count -gt 0 ]; then
                print_status $YELLOW "⚠️  Console statements found in $file ($console_count occurrences)"
                print_status $YELLOW "    Consider removing or replacing with proper logging"
            fi
        fi
    done
fi

# 7. Check for TODO/FIXME comments
if [ ! -z "$STAGED_JS_FILES" ]; then
    print_status $YELLOW "📝 Checking for TODO/FIXME comments..."
    todo_count=0
    for file in $STAGED_JS_FILES; do
        if [ -f "$file" ]; then
            file_todos=$(grep -c -i "TODO\|FIXME\|HACK\|XXX" "$file" 2>/dev/null || echo "0")
            todo_count=$((todo_count + file_todos))
            if [ $file_todos -gt 0 ]; then
                print_status $YELLOW "📝 Found $file_todos TODO/FIXME comments in $file"
            fi
        fi
    done
    
    if [ $todo_count -gt 0 ]; then
        print_status $YELLOW "📝 Total TODO/FIXME comments in staged files: $todo_count"
        print_status $YELLOW "    Consider addressing these before committing to main/production"
    fi
fi

# 8. JSON validation
if [ ! -z "$STAGED_JSON_FILES" ]; then
    run_check "JSON validation" "node -e \"
const fs = require('fs');
const files = '$STAGED_JSON_FILES'.split(' ');
let allValid = true;

files.forEach(file => {
  if (fs.existsSync(file)) {
    try {
      JSON.parse(fs.readFileSync(file, 'utf8'));
      console.log('✅ Valid JSON:', file);
    } catch (error) {
      console.error('❌ Invalid JSON:', file, error.message);
      allValid = false;
    }
  }
});

process.exit(allValid ? 0 : 1);
\"" true
fi

# Final summary
print_status $GREEN "🎉 Pre-commit quality checks completed!"
print_status $GREEN "🚀 Ready to commit with enhanced quality assurance"

# Optional: Show commit message preview
if [ -f .gitmessage ]; then
    print_status $YELLOW "📝 Commit message template:"
    echo ""
    cat .gitmessage
    echo ""
fi

exit 0