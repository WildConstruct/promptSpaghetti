{
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "types": ["jest", "@testing-library/jest-dom", "seedrandom"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*", "client/**/*"],
  "exclude": [
    "node_modules",
    "**/PythonTransform.ts",
    "**/python-executor-client.ts",
    "**/__tests__/PythonTransform.test.ts",
    "**/__tests__/executor/executor.test.ts",
    "**/__tests__/nodeDataUtils.test.ts",
    "**/__tests__/correctionsStore.test.ts",
    "**/__tests__/Inspector/*",
    "**/__tests__/components/*"
  ]
}
