{
  "version": 2,
  "name": "promptscape-graph",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/client/$1"
    }
  ],
  "functions": {
    "api/preview.js": {
      "maxDuration": 30
    },
    "api/export.js": {
      "maxDuration": 30
    },
    "api/deployment-gate.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 10
    },
    "api/admin-config.js": {
      "maxDuration": 10
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
