{
  "version": "1.0.0",
  "name": "Roman Citizen Automa Greenscreen",
  "description": "Randomizable Roman citizen prompts for Automa-style greenscreen generation.",
  "metadata": {
    "type": "ASSET_FRAGMENT",
    "category": "extras",
    "tags": [
      "roman",
      "automa",
      "greenscreen",
      "extras"
    ],
    "original_version": "0.3.0",
    "entrypoints": [
      "final_prompt",
      "final_negative_prompt"
    ],
    "deprecated": true,
    "deprecation_note": "Full-document form (contains Output nodes); superseded by the conformed RomanCitizen fragment. Not published."
  },
  "nodes": [
    {
      "id": "gender",
      "type": "WeightedChoice",
      "name": "Gender",
      "description": "Selects the subject's gender",
      "x": 0,
      "y": 0,
      "options": [
        {
          "id": "gender-male",
          "text": "male",
          "weight": 50
        },
        {
          "id": "gender-female",
          "text": "female",
          "weight": 50
        }
      ]
    },
    {
      "id": "social_class",
      "type": "WeightedChoice",
      "name": "Social Class",
      "description": "Economic standing of the citizen",
      "x": 220,
      "y": 0,
      "options": [
        {
          "id": "social-lower",
          "text": "lower-class",
          "weight": 50
        },
        {
          "id": "social-middle",
          "text": "middle-class",
          "weight": 30
        },
        {
          "id": "social-upper",
          "text": "upper-class",
          "weight": 20
        }
      ]
    },
    {
      "id": "age_band",
      "type": "WeightedChoice",
      "name": "Age Band",
      "description": "Approximate age grouping",
      "x": 440,
      "y": 0,
      "options": [
        {
          "id": "age-young",
          "text": "young adult",
          "weight": 40
        },
        {
          "id": "age-middle",
          "text": "middle-aged",
          "weight": 40
        },
        {
          "id": "age-older",
          "text": "older adult",
          "weight": 20
        }
      ]
    },
    {
      "id": "role",
      "type": "WeightedChoice",
      "name": "Role",
      "description": "Occupation or social role",
      "x": 660,
      "y": 0,
      "options": [
        {
          "id": "role-citizen",
          "text": "citizen",
          "weight": 45
        },
        {
          "id": "role-laborer",
          "text": "laborer",
          "weight": 35
        },
        {
          "id": "role-merchant",
          "text": "merchant",
          "weight": 15
        },
        {
          "id": "role-official",
          "text": "minor official",
          "weight": 5
        }
      ]
    },
    {
      "id": "base_wardrobe",
      "type": "WeightedChoice",
      "name": "Base Wardrobe",
      "description": "Primary clothing description",
      "x": 0,
      "y": 220,
      "options": [
        {
          "id": "wardrobe-muted",
          "text": "wool tunic in muted natural dyes such as madder red, indigo, cream, or undyed beige, simple leather sandals",
          "weight": 45
        },
        {
          "id": "wardrobe-earthy",
          "text": "rough-spun wool tunic in faded earth tones with a rope belt and worn leather sandals",
          "weight": 35
        },
        {
          "id": "wardrobe-clavus",
          "text": "clean white tunic with a dyed clavus stripe and well kept leather sandals",
          "weight": 15
        },
        {
          "id": "wardrobe-trimmed",
          "text": "slightly nicer wool tunic with subtle decorative trims and good quality sandals",
          "weight": 5
        }
      ]
    },
    {
      "id": "outer_layer",
      "type": "WeightedChoice",
      "name": "Outer Layer",
      "description": "Cloaks and additional garments",
      "x": 220,
      "y": 220,
      "options": [
        {
          "id": "outer-none",
          "text": "no outer cloak",
          "weight": 30
        },
        {
          "id": "outer-paenula",
          "text": "a lightweight cloak (paenula) draped naturally over one shoulder",
          "weight": 45
        },
        {
          "id": "outer-travel",
          "text": "a heavier travel cloak loosely wrapped around the shoulders",
          "weight": 15
        },
        {
          "id": "outer-toga",
          "text": "a carefully draped toga that signals modest wealth",
          "weight": 10
        }
      ]
    },
    {
      "id": "face_world_wear",
      "type": "WeightedChoice",
      "name": "Face Wear",
      "description": "Weathering and complexion",
      "x": 440,
      "y": 220,
      "options": [
        {
          "id": "face-sun-browned",
          "text": "sun-browned skin with fine lines around the eyes and mouth, subtle dust from city streets, natural uneven complexion, no makeup, no modern grooming",
          "weight": 35
        },
        {
          "id": "face-weathered",
          "text": "weathered features with wind exposure, a few light scars, visible pores, some grime at the hairline, slightly chapped lips, no polished look",
          "weight": 30
        },
        {
          "id": "face-tired",
          "text": "tired eyes, mild under-eye shadows, sun damage on the cheeks, faint sweat marks and dust, rough skin texture, natural brow and hair shape",
          "weight": 20
        },
        {
          "id": "face-elder",
          "text": "older skin with deeper wrinkles from outdoor work, visible pores, age spots, and city dust, no sign of modern skincare",
          "weight": 15
        }
      ]
    },
    {
      "id": "hair_description",
      "type": "WeightedChoice",
      "name": "Hair",
      "description": "Era-appropriate hair styling",
      "x": 660,
      "y": 220,
      "options": [
        {
          "id": "hair-simple",
          "text": "simple era-appropriate hair, slightly unkempt from outdoor life, no modern styling products",
          "weight": 35
        },
        {
          "id": "hair-short",
          "text": "short, practical haircut with a bit of sweat and dust in the hair, no sharp modern fade",
          "weight": 30
        },
        {
          "id": "hair-tied",
          "text": "loosely tied-back hair with a few stray strands, clearly not styled with modern products",
          "weight": 20
        },
        {
          "id": "hair-curls",
          "text": "tight natural curls or waves that show slight frizz and dust from the streets",
          "weight": 15
        }
      ]
    },
    {
      "id": "small_props",
      "type": "WeightedChoice",
      "name": "Props",
      "description": "Hand props and small details",
      "x": 0,
      "y": 440,
      "options": [
        {
          "id": "props-none",
          "text": "no props in the hands",
          "weight": 50
        },
        {
          "id": "props-pouch",
          "text": "a simple leather belt pouch",
          "weight": 20
        },
        {
          "id": "props-bundle",
          "text": "a small cloth bundle tied at the waist",
          "weight": 15
        },
        {
          "id": "props-jewelry",
          "text": "a plain ring or brooch that feels period accurate",
          "weight": 15
        }
      ]
    },
    {
      "id": "pose_description",
      "type": "WeightedChoice",
      "name": "Pose",
      "description": "Overall stance",
      "x": 220,
      "y": 440,
      "options": [
        {
          "id": "pose-neutral",
          "text": "neutral pose, arms relaxed at sides, full body facing camera",
          "weight": 40
        },
        {
          "id": "pose-relaxed",
          "text": "relaxed stance with weight on one leg, torso slightly turned, head facing the camera",
          "weight": 30
        },
        {
          "id": "pose-contrapposto",
          "text": "slight contrapposto with one foot forward, arms at rest, calm expression",
          "weight": 20
        },
        {
          "id": "pose-gestural",
          "text": "very subtle gestural pose, as if pausing mid step but still easy to cut out for compositing",
          "weight": 10
        }
      ]
    },
    {
      "id": "lighting_description",
      "type": "WeightedChoice",
      "name": "Lighting",
      "description": "Lighting setup",
      "x": 440,
      "y": 440,
      "options": [
        {
          "id": "lighting-soft",
          "text": "soft, even studio lighting with minimal shadows, flat greenscreen background for clean matte extraction",
          "weight": 100
        }
      ]
    },
    {
      "id": "camera_description",
      "type": "WeightedChoice",
      "name": "Camera",
      "description": "Camera placement",
      "x": 660,
      "y": 440,
      "options": [
        {
          "id": "camera-straight",
          "text": "full-body framing, straight-on camera angle, no dramatic perspective",
          "weight": 100
        }
      ]
    },
    {
      "id": "negative_prompt",
      "type": "WeightedChoice",
      "name": "Negative Prompt",
      "description": "Elements to avoid",
      "x": 0,
      "y": 660,
      "options": [
        {
          "id": "negative-default",
          "text": "modern clothing, perfect skin, makeup, modern grooming, glossy highlights, airbrushed complexion, modern haircut, modern jewelry, environment, scenery, colosseum, crowds, props touching frame edge, motion blur, fantasy elements, armor, dramatic cinematic lighting, logos, text",
          "weight": 100
        }
      ]
    },
    {
      "id": "final_prompt",
      "type": "Output",
      "x": 440,
      "y": 660,
      "template": "A single {{gender}} {{age_band}} {{social_class}} Roman {{role}} standing full-body on a clean greenscreen background. The clothing is {{base_wardrobe}} with {{outer_layer}}. The face is {{face_world_wear}}. The hair is {{hair_description}}. The person has {{small_props}}. The pose is {{pose_description}}. Lighting is {{lighting_description}} and {{camera_description}}. High detail in fabric weave, leather texture, skin texture, and edges for clean compositing.",
      "data": {
        "label": "Final Prompt"
      },
      "name": "Final Prompt"
    },
    {
      "id": "final_negative_prompt",
      "type": "Output",
      "x": 660,
      "y": 660,
      "template": "{{negative_prompt}}",
      "data": {
        "label": "Negative Prompt"
      },
      "name": "Final Negative Prompt"
    }
  ],
