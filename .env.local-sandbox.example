# Local sandbox generation is an optional local-only demo lane.
# Copy this file to .env.local-sandbox or server/.env.local-sandbox.
# Do not use this lane as a hosted production image-generation backend.

ENABLE_LOCAL_IMAGE_SANDBOX=true
LOCAL_IMAGE_COMFY_API_URL=http://127.0.0.1:8188
LOCAL_IMAGE_COMFY_CHECKPOINT=flux1-schnell-fp8.safetensors
LOCAL_IMAGE_OUTPUT_DIR=.local-output/local-image-sandbox

# Optional Comfy workflow tuning for the pinned Flux Schnell FP8 checkpoint.
# The defaults are intentionally fast for the local tree demo.
LOCAL_IMAGE_COMFY_STEPS=4
LOCAL_IMAGE_COMFY_CFG=1
LOCAL_IMAGE_COMFY_SAMPLER=euler
LOCAL_IMAGE_COMFY_SCHEDULER=normal
LOCAL_IMAGE_COMFY_TIMEOUT_MS=120000
LOCAL_IMAGE_COMFY_POLL_MS=1500
