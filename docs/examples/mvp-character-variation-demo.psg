{
  "version": "1.0.0",
  "name": "MVP Character Variation Demo",
  "description": "Quick demo graph for controlled character variation using the weekend MVP node subset.",
  "metadata": {
    "author": "Prompt Spaghetti",
    "tags": ["mvp", "demo", "character", "variation"],
    "source": "docs/examples/mvp-character-variation-demo.psg"
  },
  "nodes": [
    {
      "id": "base",
      "type": "TextBlock",
      "name": "Base",
      "x": 120,
      "y": 120,
      "value": "A capable field operative"
    },
    {
      "id": "role",
      "type": "WeightedChoice",
      "name": "Role",
      "x": 120,
      "y": 260,
      "options": [
        { "text": "scout", "weight": 4 },
        { "text": "mediator", "weight": 2 },
        { "text": "saboteur", "weight": 2 }
      ]
    },
    {
      "id": "detail",
      "type": "WeightedChoice",
      "name": "Detail",
      "x": 420,
      "y": 260,
      "options": [
        { "text": "with weathered gear", "weight": 3 },
        { "text": "with immaculate tailoring", "weight": 2 },
        { "text": "with improvised equipment", "weight": 2 }
      ]
    },
    {
      "id": "join",
      "type": "Concat",
      "name": "Join",
      "x": 720,
      "y": 160,
      "value": ", "
    },
    {
      "id": "join-detail",
      "type": "Concat",
      "name": "Join Detail",
      "x": 1020,
      "y": 220,
      "value": ", "
    },
    {
      "id": "result",
      "type": "Output",
      "name": "Result",
      "x": 1320,
      "y": 220,
      "template": "{{input}}"
    }
  ],
  "edges": [
    {
      "id": "edge-base-join",
      "source": "base",
      "target": "join",
      "targetHandle": "input1"
    },
    {
      "id": "edge-role-join",
      "source": "role",
      "target": "join",
      "targetHandle": "input2"
    },
    {
      "id": "edge-join-join-detail",
      "source": "join",
      "target": "join-detail",
      "targetHandle": "input1"
    },
    {
      "id": "edge-detail-join-detail",
      "source": "detail",
      "target": "join-detail",
      "targetHandle": "input2"
    },
    {
      "id": "edge-join-detail-result",
      "source": "join-detail",
      "target": "result"
    }
  ],
  "regions": [
    {
      "id": "character-region",
      "name": "Character Variation",
      "color": "#22c55e",
      "nodes": ["base", "role", "detail", "join", "join-detail", "result"],
      "description": "Golden-path character variation demo region"
    }
  ]
}
