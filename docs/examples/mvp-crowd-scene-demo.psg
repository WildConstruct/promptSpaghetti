{
  "version": "1.0.0",
  "name": "MVP Crowd Scene Demo",
  "description": "Quick demo graph for crowd-oriented setup before hosted crowd expansion and scene-sidecar work.",
  "metadata": {
    "author": "Prompt Spaghetti",
    "tags": ["mvp", "demo", "crowd", "scene"],
    "source": "docs/examples/mvp-crowd-scene-demo.psg"
  },
  "nodes": [
    {
      "id": "base-scene",
      "type": "TextBlock",
      "name": "Base Scene",
      "x": 120,
      "y": 120,
      "value": "A public market square prepared for a festival"
    },
    {
      "id": "crowd-plan",
      "type": "WeightedChoice",
      "name": "Crowd Plan",
      "x": 120,
      "y": 300,
      "options": [
        { "text": "dense civilian traffic with clustered conversations", "weight": 4 },
        { "text": "mixed merchants and passersby with open sightlines", "weight": 3 },
        { "text": "festival arrivals with banners and family groups", "weight": 2 }
      ]
    },
    {
      "id": "placement",
      "type": "WeightedChoice",
      "name": "Placement",
      "x": 480,
      "y": 300,
      "options": [
        { "text": "foreground anchors with layered midground movement", "weight": 4 },
        { "text": "balanced edge population with a clear central aisle", "weight": 2 },
        { "text": "denser rear clustering and sparse foreground", "weight": 2 }
      ]
    },
    {
      "id": "join-crowd",
      "type": "Concat",
      "name": "Join Crowd",
      "x": 820,
      "y": 190,
      "value": ", "
    },
    {
      "id": "join-placement",
      "type": "Concat",
      "name": "Join Placement",
      "x": 1140,
      "y": 230,
      "value": ", "
    },
    {
      "id": "result",
      "type": "Output",
      "name": "Result",
      "x": 1440,
      "y": 230,
      "template": "{{input}}"
    }
  ],
  "edges": [
    {
      "id": "edge-base-scene-join-crowd",
      "source": "base-scene",
      "target": "join-crowd",
      "targetHandle": "input1"
    },
    {
      "id": "edge-crowd-plan-join-crowd",
      "source": "crowd-plan",
      "target": "join-crowd",
      "targetHandle": "input2"
    },
    {
      "id": "edge-join-crowd-join-placement",
      "source": "join-crowd",
      "target": "join-placement",
      "targetHandle": "input1"
    },
    {
      "id": "edge-placement-join-placement",
      "source": "placement",
      "target": "join-placement",
      "targetHandle": "input2"
    },
    {
      "id": "edge-join-placement-result",
      "source": "join-placement",
      "target": "result"
    }
  ],
  "regions": [
    {
      "id": "crowd-region",
      "name": "Crowd Scene Setup",
      "color": "#f59e0b",
      "nodes": ["base-scene", "crowd-plan", "placement", "join-crowd", "join-placement", "result"],
      "description": "Golden-path crowd scene demo region"
    }
  ]
}
