{
  "meta": {
    "name": "Fantasy Character Generator",
    "version": "2.0.0",
    "author": "Handbook Examples",
    "description": "Intermediate generator showing weighted choices, variables, and modularization"
  },
  "variables": {
    "characterName": "",
    "characterClass": "",
    "level": 1
  },
  "includes": {
    "names": "./character-names.json"
  },
  "grammar": {
    "start": "[setClass][setName][character]",
    
    "setClass": {
      "type": "setVariable",
      "key": "characterClass",
      "value": "[class]"
    },
    
    "setName": {
      "type": "setVariable", 
      "key": "characterName",
      "value": "[fullName]"
    },
    
    "character": "{characterName} the [epithet] {characterClass}",
    
    "fullName": "[names:first] [names:last]",
    
    "class": [
      {"w": 30, "v": "Warrior"},
      {"w": 25, "v": "Mage"},
      {"w": 25, "v": "Rogue"},
      {"w": 10, "v": "Cleric"},
      {"w": 5, "v": "Paladin"},
      {"w": 3, "v": "Necromancer"},
      {"w": 2, "v": "Druid"}
    ],
    
    "epithet": [
      {"w": 50, "v": "[common_epithet]"},
      {"w": 35, "v": "[uncommon_epithet]"},
      {"w": 15, "v": "[rare_epithet]"}
    ],
    
    "common_epithet": [
      "Bold", "Brave", "Swift", "Strong", "Wise"
    ],
    
    "uncommon_epithet": [
      "Cunning", "Mysterious", "Ancient", "Forgotten", "Wandering"
    ],
    
    "rare_epithet": [
      "Legendary", "Immortal", "Prophesied", "Cursed", "Divine"
    ]
  },
  
  "entryPoints": ["start", "quickName", "classOnly"],
  
  "quickName": "[fullName]",
  "classOnly": "a [epithet] [class]"
}