# Client environment variables example
# Copy this file to .env.local for local app configuration

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_PYTHON_EXECUTOR_URL=http://localhost:8001
VITE_WEBSOCKET_URL=ws://localhost:8001

# Feature Flags
VITE_ANALYTICS_ENABLED=true
VITE_DEBUG_MODE=true
VITE_FEATURE_FLAGS_ENABLED=true

# Supabase (optional; previews should work without these)
# If provided, Supabase-backed features will be enabled in UI
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Feature flag to disable Supabase globally regardless of env presence (1=on, 0=off)
VITE_FEATURE_SUPABASE=1

# Optional Vercel deployment protection bypass for local testing only
# VITE_VERCEL_PROTECTION_BYPASS=YOUR_OPTIONAL_BYPASS_VALUE_HERE

# For production deployment, set these in your hosting provider environment:
# VITE_API_URL=https://api.yourdomain.com
# VITE_PYTHON_EXECUTOR_URL=https://python.yourdomain.com
# VITE_WEBSOCKET_URL=wss://ws.yourdomain.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
# VITE_FEATURE_SUPABASE=0
# VITE_VERCEL_PROTECTION_BYPASS=YOUR_OPTIONAL_BYPASS_VALUE_HERE
