        "position": { "x": 100, "y": 200 },
        "data": {
          "choices": [
            { "text": "ancient stone walls covered in luminescent moss", "weight": 1 },
            { "text": "towering spires that seemed to pierce the very clouds", "weight": 1 },
            { "text": "narrow alleyways where shadows danced like living things", "weight": 1 },
            { "text": "crystalline formations that hummed with inner light", "weight": 1 },
            { "text": "weathered statues whose eyes seemed to follow passersby", "weight": 1 },
            { "text": "market stalls overflowing with exotic spices and strange artifacts", "weight": 1 },
            { "text": "forgotten gardens where time itself seemed to slow", "weight": 1 },
            { "text": "grand halls with frescoes depicting long-lost histories", "weight": 1 }
