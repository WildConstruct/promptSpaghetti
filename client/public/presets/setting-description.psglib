        "type": "WeightedChoice",
        "position": { "x": 100, "y": 300 },
        "data": {
          "choices": [
            { "text": "An unsettling quiet pervaded everything", "weight": 1 },
            { "text": "The bustle of daily life continued, oblivious to the danger", "weight": 1 },
            { "text": "A sense of ancient power thrummed beneath the surface", "weight": 1 },
            { "text": "Even the bravest souls hurried through without lingering", "weight": 1 },
            { "text": "Beauty and decay existed in perfect, terrible harmony", "weight": 1 },
            { "text": "It was a place where dreams and nightmares converged", "weight": 1 }
