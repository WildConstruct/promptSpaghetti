{
  "name": "promptscape-graph",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Monorepo for PromptScape Randomizer Graph editor and executor.",
  "workspaces": [
    "client",
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "echo 'Monorepo bootstrap complete.'",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --ignore-path .gitignore",
    "test": "jest --coverage",
    "build": "turbo run build",
    "build:web": "cd client && npm install && npm run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "check:deps": "node tests/build-verification/scripts/quick-check.js",
    "clean:modules": "rimraf node_modules client/node_modules packages/*/node_modules apps/*/node_modules",
    "fix:deps": "npm run clean:modules && npm install && cd client && npm install",
    "verify:build": "npm run check:deps && npm run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.4",
    "seedrandom": "^3.0.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "@ant-design/icons": "^6.0.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "antd": "^5.26.5",
    "babel-jest": "^30.0.4",
    "chalk": "^4.1.2",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lib0": "^0.2.114",
    "lucide-react": "^0.525.0",
    "pg": "^8.16.3",
    "prettier": "^3.0.0",
    "react-grid-heatmap": "^1.3.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "recharts": "^3.1.0",
    "redis": "^5.6.0",
    "rimraf": "^5.0.0",
    "semver": "^7.7.2",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "yjs": "^13.6.27",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  }
}
