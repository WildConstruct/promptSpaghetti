{
  "name": "promptscape-graph",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Monorepo for PromptScape Randomizer Graph editor and executor.",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "postinstall": "echo 'Monorepo bootstrap complete.'",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --ignore-path .gitignore",
    "lint:sonar": "eslint . --config .eslintrc.sonar.json --ext .ts,.tsx,.js,.jsx --ignore-path .gitignore",
    "analyze": "node scripts/analyze-code-quality.js",
    "quality:check": "npm run lint && npm run typecheck && npm run analyze",
    "test": "jest --coverage",
    "test:clean": "./scripts/clean-duplicate-tests.sh && jest --coverage",
    "pretest": "./scripts/clean-duplicate-tests.sh",
    "test:coverage": "jest --coverage --coverageReporters=json,lcov,text,clover",
    "test:coverage:report": "jest --coverage --coverageReporters=html && open coverage/index.html",
    "test:security": "jest --testPathPattern=\"(security|validation|ast-node-whitelist)\" --coverage",
    "build": "turbo run build",
    "build:web": "pnpm --filter client build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "check:deps": "node tests/build-verification/scripts/quick-check.js",
    "clean:modules": "rimraf node_modules client/node_modules packages/*/node_modules apps/*/node_modules",
    "fix:deps": "pnpm run clean:modules && pnpm install",
    "verify:build": "pnpm run check:deps && pnpm run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "lint:fix": "node scripts/fix-lint-errors.js",
    "test:docs": "jest tests/documentation --testPathPattern=\"docs\"",
    "test:docs:watch": "jest tests/documentation --watch",
    "test:docs:coverage": "jest tests/documentation --coverage",
    "test:comprehensive": "node scripts/run-comprehensive-tests.js",
    "test:edge-cases": "node scripts/run-comprehensive-tests.js --edge-cases-only",
    "test:reliability": "node scripts/run-comprehensive-tests.js --reliability-only",
    "test:performance-only": "node scripts/run-comprehensive-tests.js --performance-only",
    "test:unit-only": "node scripts/run-comprehensive-tests.js --unit-only",
    "lint:strict": "node scripts/toggle-lint-mode.js strict",
    "lint:permissive": "node scripts/toggle-lint-mode.js permissive",
    "lint:status": "node scripts/toggle-lint-mode.js status",
    "commit:safe": "node scripts/fix-lint-errors.js && git add -u && git commit",
    "commit:force": "git commit --no-verify",
    "rule-test": "ts-node server/src/cli/rule-testing-cli.ts",
    "rule-test:setup": "npm run rule-test setup",
    "rule-test:run": "npm run rule-test run",
    "rule-test:benchmark": "npm run rule-test benchmark",
    "rule-test:status": "npm run rule-test status",
    "rule-test:teardown": "npm run rule-test teardown",
    "test:infrastructure": "jest tests/infrastructure --testPathPattern=infrastructure",
    "test:infrastructure:watch": "jest tests/infrastructure --watch",
    "test:infrastructure:coverage": "jest tests/infrastructure --coverage",
    "test:performance-scenarios": "jest tests/infrastructure --testPathPattern=performance-scenarios",
    "test:harness": "jest tests/infrastructure --testPathPattern=TestHarness",
    "test:orchestrator": "node scripts/test-automation-orchestrator.js",
    "test:orchestrator:parallel": "node scripts/test-automation-orchestrator.js --parallel",
    "test:orchestrator:sequential": "node scripts/test-automation-orchestrator.js --sequential",
    "test:orchestrator:fast-fail": "node scripts/test-automation-orchestrator.js --fail-fast",
    "test:ci-enhanced": "npm run test:infrastructure && npm run test:performance-scenarios && npm run test",
    "test:matrix": "npm run test:unit-only && npm run test:integration && npm run test:performance-only && npm run test:docs",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --project=mobile",
    "test:security-scan": "jest --testPathPattern=security",
    "test:quality-gates": "npm run lint && npm run typecheck && npm run test:security-scan && npm run test:performance-only",
    "test-data:cleanup": "node scripts/test-data-cleanup.js",
    "test-data:cleanup:dry-run": "node scripts/test-data-cleanup.js --dry-run",
    "test-data:cleanup:aggressive": "node scripts/test-data-cleanup.js --aggressive",
    "test-data:cleanup:schedule": "node scripts/test-data-cleanup.js --schedule",
    "test:state-transitions": "node scripts/run-state-transition-tests.js",
    "test:state-transitions:sequential": "node scripts/run-state-transition-tests.js --sequential",
    "test:state-transitions:quick": "jest --testPathPattern=state-transitions --no-coverage"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.4",
    "seedrandom": "^3.0.5",
    "ts-node": "^10.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@faker-js/faker": "^9.9.0",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.54.1",
    "@tanstack/react-query": "^5.83.0",
    "@testcontainers/postgresql": "^11.3.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/glob": "^9.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/seedrandom": "^3.0.8",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "antd": "^5.26.5",
    "babel-jest": "^30.0.4",
    "chalk": "^4.1.2",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.0.4",
    "lib0": "^0.2.114",
    "lint-staged": "^15.2.0",
    "lucide-react": "^0.525.0",
    "markdown-it": "^14.1.0",
    "msw": "^2.10.4",
    "pg": "^8.16.3",
    "prettier": "^3.0.0",
    "react-grid-heatmap": "^1.3.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "recharts": "^3.1.0",
    "redis": "^5.6.0",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "rimraf": "^5.0.0",
    "semver": "^7.7.2",
    "ts-jest": "^29.4.0",
    "turbo": "^1.13.0",
    "typescript": "^5.0.0",
    "yjs": "^13.6.27"
  }
}
