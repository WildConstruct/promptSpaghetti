{
  "name": "prompt-spaghetti-revenge",
  "version": "1.0.0-demo",
  "private": true,
  "description": "A powerful visual graph editor for creating dynamic, randomized text generation workflows",
  "author": "WildConstruct",
  "license": "UNLICENSED",
  "homepage": "https://github.com/WildConstruct/promptSpaghetti",
  "repository": {
    "type": "git",
    "url": "https://github.com/WildConstruct/promptSpaghetti.git"
  },
  "bugs": {
    "url": "https://github.com/WildConstruct/promptSpaghetti/issues"
  },
  "keywords": [
    "prompt-engineering",
    "graph-editor",
    "text-generation",
    "visual-programming",
    "node-based",
    "react-flow"
  ],
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.8",
      "cross-spawn@<6.0.6": "^7.0.6",
      "protobufjs@<7.5.5": "^7.5.5",
      "handlebars@<=4.7.8": "^4.7.9",
      "basic-ftp@<5.2.0": "^5.2.0",
      "tmp@<0.2.6": "^0.2.6",
      "playwright@<1.55.1": "^1.55.1",
      "fastify@>=5.0.0 <5.7.2": "^5.7.2",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "undici@>=7.0.0 <7.24.0": "^7.24.0",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "fast-uri@<3.1.2": "^3.1.2",
      "jws@<3.2.3": "^3.2.3",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "react-router@>=7.0.0 <7.15.0": "^7.15.0",
      "react-router-dom@>=7.0.0 <7.15.0": "^7.15.0",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <7.29.4": "^7.29.4",
      "@grpc/grpc-js@>=1.13.0 <1.13.5": "^1.13.5",
      "@isaacs/brace-expansion@<=5.0.0": "^5.0.1",
      "flatted@<3.4.2": "^3.4.2",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "glob@>=11.0.0 <11.1.0": "^11.1.0",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "^5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "tar@>=7.0.0 <7.5.11": "^7.5.11",
      "tar-fs@>=2.0.0 <2.1.4": "^2.1.4",
      "tar-fs@>=3.0.0 <3.1.1": "^3.1.1",
      "vite@>=6.0.0 <6.4.3": "^6.4.3",
      "vite@>=7.0.0 <7.3.5": "^7.3.5"
    }
  },
  "scripts": {
    "postinstall": "echo 'Monorepo bootstrap complete.'",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:sonar": "eslint . --config .eslintrc.sonar.json --ext .ts,.tsx,.js,.jsx",
    "analyze": "node scripts/analyze-code-quality.js",
    "quality:check": "npm run lint && npm run typecheck && npm run analyze",
    "test": "jest --config jest.config.js --coverage",
    "test:packages": "jest --config jest.config.js --coverage",
    "test:unit": "pnpm test:packages",
    "test:client": "pnpm --filter client test",
    "test:coverage": "jest --config jest.config.js --coverage --coverageReporters=json,lcov,text,clover",
    "test:coverage:report": "jest --config jest.config.js --coverage --coverageReporters=html && open coverage/index.html",
    "coverage:report": "node scripts/report-low-coverage.js",
    "test:security": "jest --testPathPattern=\"(security|validation|ast-node-whitelist)\" --coverage",
    "build": "turbo run build",
    "build:web": "pnpm --filter client build",
    "build:netlify": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy\\runDeployPackaging.ps1 -Phase netlify-build",
    "build:vercel-api": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy\\runDeployPackaging.ps1 -Phase vercel-api-build",
    "validate:deploy:active": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy\\runDeployPackaging.ps1",
    "validate:deploy:mvp": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy\\runDeployPackaging.ps1",
    "validate:artifacts:active": "powershell -ExecutionPolicy Bypass -File .\\scripts\\artifacts\\runArtifactValidation.ps1",
    "refresh:publish-compat": "powershell -ExecutionPolicy Bypass -File .\\scripts\\artifacts\\runPublishCompatRefresh.ps1",
    "verify:bundle": "node scripts/build-verification/check-browser-bundle.js",
    "generate:manifest": "node packages/asset-browser/scripts/build/generate-graph-manifest.mjs",
    "generate:agent-fragment-index": "node scripts/build/generate-agent-fragment-index.mjs",
    "audit:agent-fragments": "node scripts/build/audit-and-expand-agent-fragments.mjs",
    "enrich:thin-fragments": "node scripts/build/enrich-thin-fragments.mjs",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter client dev",
    "dev:local-sandbox": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-sandbox\\runLocalSandboxDev.ps1",
    "dev:local-sandbox:status": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-sandbox\\runLocalSandboxDev.ps1 -Mode status",
    "eval": "ts-node --swc packages/eval/scripts/run-eval.ts",
    "eval:ci": "TS_NODE_TRANSPILE_ONLY=1 ts-node --swc packages/eval/scripts/run-eval.ts --ci",
    "dev:server": "pnpm --filter server dev",
    "check:deps": "node tests/build-verification/scripts/quick-check.js",
    "check:conflicts": "./scripts/check-dependency-conflicts.sh",
    "validate:build": "node scripts/validate-build.js",
    "clean:malformed": "node scripts/clean-malformed-files.js",
    "clean:malformed:dry": "node scripts/clean-malformed-files.js --dry-run",
    "fix:corrupted": "node scripts/fix-corrupted-source-files.js",
    "fix:corrupted:dry": "node scripts/fix-corrupted-source-files.js --dry-run",
    "psg:repair": "node scripts/psg-repair.js",
    "clean:modules": "rimraf node_modules client/node_modules packages/*/node_modules apps/*/node_modules",
    "fix:deps": "pnpm run clean:modules && pnpm install",
    "verify:build": "pnpm run check:deps && pnpm run test",
    "typecheck": "turbo run typecheck",
    "typecheck:active": "tsc --noEmit -p tsconfig.active.json",
    "validate:active": "powershell -ExecutionPolicy Bypass -File .\\scripts\\validation\\runActiveValidation.ps1",
    "validate:active:server-smoke": "powershell -ExecutionPolicy Bypass -File .\\scripts\\validation\\runActiveValidation.ps1 -Phase server-smoke",
    "validate:active:client-smoke": "powershell -ExecutionPolicy Bypass -File .\\scripts\\validation\\runActiveValidation.ps1 -Phase client-smoke",
    "validate:unused": "knip --config knip.json --no-progress --production --files --no-config-hints",
    "validate:cycles": "node scripts/validation/runCyclesValidation.mjs",
    "validate:repo:quality": "node scripts/validation/runRepoQualityValidation.mjs",
    "local-sandbox:help": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-sandbox\\runLocalSandboxRuntime.ps1 -Mode help",
    "setup:local-sandbox:runtime": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-sandbox\\setupLocalSandboxRuntime.ps1",
    "start:local-sandbox:runtime": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-sandbox\\startLocalSandboxRuntime.ps1 -Detached",
    "validate:local-sandbox:runtime": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-sandbox\\runLocalSandboxRuntime.ps1",
    "validate:local-sandbox:smoke": "powershell -ExecutionPolicy Bypass -File .\\scripts\\validation\\runLocalSandboxValidation.ps1",
    "validate:local-sandbox:demo": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-sandbox\\runLocalSandboxDemoValidation.ps1",
    "validate:demo:flows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\validation\\runMvpShipValidation.ps1 -Phase demo-flows",
    "validate:mvp:ship": "powershell -ExecutionPolicy Bypass -File .\\scripts\\validation\\runMvpShipValidation.ps1",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "pre-commit": "lint-staged",
    "lint:fix": "node scripts/fix-lint-errors.js",
    "test:docs": "jest tests/documentation --testPathPattern=\"docs\"",
    "test:docs:watch": "jest tests/documentation --watch",
    "test:docs:coverage": "jest tests/documentation --coverage",
    "lint:strict": "node scripts/toggle-lint-mode.js strict",
    "lint:permissive": "node scripts/toggle-lint-mode.js permissive",
    "lint:status": "node scripts/toggle-lint-mode.js status",
    "lint:mode:safe": "node scripts/switch-linting-mode.js safe",
    "lint:mode:active": "node scripts/switch-linting-mode.js active",
    "lint:mode:strict": "node scripts/switch-linting-mode.js strict",
    "lint:mode:emergency": "node scripts/switch-linting-mode.js emergency",
    "commit:safe": "node scripts/fix-lint-errors.js && git add -u && git commit",
    "commit:force": "git commit --no-verify",
    "rule-test": "ts-node server/src/cli/rule-testing-cli.ts",
    "rule-test:setup": "npm run rule-test setup",
    "rule-test:run": "npm run rule-test run",
    "rule-test:benchmark": "npm run rule-test benchmark",
    "rule-test:status": "npm run rule-test status",
    "rule-test:teardown": "npm run rule-test teardown",
    "test:infrastructure": "jest tests/infrastructure --testPathPattern=infrastructure",
    "test:infrastructure:watch": "jest tests/infrastructure --watch",
    "test:infrastructure:coverage": "jest tests/infrastructure --coverage",
    "test:performance-scenarios": "jest tests/infrastructure --testPathPattern=performance-scenarios",
    "test:harness": "jest tests/infrastructure --testPathPattern=TestHarness",
    "test:epic1": "pnpm run -s test:epic1:components && pnpm run -s test:epic1:nodes",
    "test:epic1:components": "jest --config packages/core/components/epic1/jest.config.cjs",
    "test:epic1:nodes": "jest --config packages/core/runtime/nodes/epic1/jest.config.cjs",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --project=mobile",
    "test:regression:generate-golden": "node scripts/generate-golden-files.js",
    "test-data:cleanup": "node scripts/test-data-cleanup.js",
    "test-data:cleanup:dry-run": "node scripts/test-data-cleanup.js --dry-run",
    "test-data:cleanup:aggressive": "node scripts/test-data-cleanup.js --aggressive",
    "test-data:cleanup:schedule": "node scripts/test-data-cleanup.js --schedule",
    "test:state-transitions": "node scripts/run-state-transition-tests.js",
    "test:state-transitions:sequential": "node scripts/run-state-transition-tests.js --sequential",
    "test:state-transitions:quick": "jest --testPathPattern=state-transitions --no-coverage",
    "test:load-scenarios": "jest load-tests/scenarios/__tests__ --testPathPattern=LoadTestScenarios",
    "test:load-scenarios:watch": "jest load-tests/scenarios/__tests__ --watch",
    "load:scenarios": "node load-tests/scenarios/run-load-scenarios.js",
    "load:baseline": "node load-tests/scenarios/run-load-scenarios.js --category baseline",
    "load:stress": "node load-tests/scenarios/run-load-scenarios.js --category stress",
    "load:spike": "node load-tests/scenarios/run-load-scenarios.js --category spike",
    "load:comprehensive": "node load-tests/scenarios/run-load-scenarios.js --comprehensive",
    "load:list": "node load-tests/scenarios/run-load-scenarios.js --list",
    "load:dry-run": "node load-tests/scenarios/run-load-scenarios.js --comprehensive --dry-run",
    "perf:test": "node scripts/run-performance-tests.js",
    "perf:quick": "node scripts/run-performance-tests.js --quick",
    "perf:stress": "node scripts/run-performance-tests.js --stress",
    "perf:load-only": "node scripts/run-performance-tests.js --suite load-only",
    "perf:scenarios-only": "node scripts/run-performance-tests.js --suite scenarios-only",
    "perf:comprehensive": "node scripts/run-performance-tests.js --suite comprehensive",
    "perf:budget": "node scripts/performance-budget-check.js",
    "perf:budget:strict": "node scripts/performance-budget-check.js --strict",
    "perf:budget:json": "node scripts/performance-budget-check.js --json",
    "perf:budget:config": "node scripts/performance-budget-check.js --config performance-budget.json",
    "perf:monitor": "node -e \"const { PerformanceMonitoringDashboard } = require('./packages/core/performance/PerformanceMonitoringDashboard'); const dashboard = new PerformanceMonitoringDashboard(); dashboard.startMonitoring();\"",
    "perf:snapshot": "node -e \"const { PerformanceMonitoringDashboard } = require('./packages/core/performance/PerformanceMonitoringDashboard'); const dashboard = new PerformanceMonitoringDashboard(); dashboard.capturePerformanceSnapshot().then(console.log);\"",
    "load:k6": "node scripts/run-k6-tests.js",
    "load:k6:baseline": "node scripts/run-k6-tests.js --scenario baseline",
    "load:k6:load": "node scripts/run-k6-tests.js --scenario load",
    "load:k6:stress": "node scripts/run-k6-tests.js --scenario stress",
    "load:k6:spike": "node scripts/run-k6-tests.js --scenario spike",
    "load:k6:breakpoint": "node scripts/run-k6-tests.js --scenario breakpoint",
    "load:k6:all": "node scripts/run-k6-tests.js --all",
    "test:performance-integration": "jest tests/performance/PerformanceTestIntegration.test.ts --verbose",
    "perf:integrated": "node -e \"const { PerformanceTestIntegration } = require('./tests/performance/PerformanceTestIntegration'); const integration = new PerformanceTestIntegration(); integration.executeComprehensivePerformanceTest().then(report => console.log('Performance Score:', report.overallScore, '/100')).catch(console.error);\"",
    "perf:health-check": "node -e \"const { PerformanceTestIntegration } = require('./tests/performance/PerformanceTestIntegration'); const integration = new PerformanceTestIntegration(); integration.quickHealthCheck().then(health => console.log('Health Status:', health.status, 'Issues:', health.issues.length)).catch(console.error);\"",
    "test:performance-full": "npm run test:performance-integration && npm run perf:integrated",
    "test:automation": "jest tests/automation/ --verbose",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "version": "npm run changelog && git add CHANGELOG.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.54.0",
    "commander": "^12.1.0",
    "fastify": "^5.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "seedrandom": "^3.0.5",
    "ts-node": "^10.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.54.2",
    "@tanstack/react-query": "^5.85.0",
    "@testcontainers/postgresql": "^11.5.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/glob": "^9.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/seedrandom": "^3.0.8",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "babel-jest": "^29.7.0",
    "chalk": "^4.1.2",
    "conventional-changelog-cli": "^5.0.0",
    "esbuild": "^0.25.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^6.4.1",
    "lint-staged": "^15.5.2",
    "lucide-react": "^0.525.0",
    "madge": "^8.0.0",
    "msw": "^2.10.4",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-router-dom": "^7.8.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.1",
    "turbo": "^1.13.4",
    "typescript": "^5.8.3"
  }
}
