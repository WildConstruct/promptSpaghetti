{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "types": ["node"]
  },
  "include": [
    "packages/asset-browser/src/**/*",
    "packages/core/public.ts",
    "packages/core/utils/index.ts",
    "packages/core/utils/psgCodec.ts",
    "packages/core/utils/psgStorage.ts",
    "packages/core/utils/supabaseClient.ts",
    "packages/core/utils/supabaseFeature.ts",
    "packages/core/types/graph.ts",
    "packages/core/index.ts"
  ],
  "exclude": [
    "client/**",
    "legacy/**",
    "packages/core/runtime/**",
    "packages/prompt-targeting/**",
    "packages/asset-browser/tests/**",
    "packages/asset-browser/types/**",
    "packages/asset-browser/jest.config.*",
    "packages/asset-browser/jest.setup.*",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/dist/**",
    "**/node_modules/**"
  ]
}
