#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Safer pre-commit hook that checks but doesn't auto-fix aggressively

echo "🔍 Running pre-commit checks..."

# 1. Check for syntax errors first (no auto-fix)
echo "📋 Checking for syntax errors..."
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ ! -z "$STAGED_TS_FILES" ]; then
  if [ -f tsconfig.active.json ]; then
    echo "➡️  Using tsconfig.active.json"
    npx tsc -p tsconfig.active.json --noEmit --skipLibCheck
  else
    npx tsc --noEmit --skipLibCheck
  fi
  if [ $? -ne 0 ]; then
    echo "❌ TypeScript compilation errors found. Please fix them before committing."
    exit 1
  fi
fi

# 2. Check formatting (don't auto-fix)
echo "🎨 Checking code formatting..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json)$' || true)

if [ ! -z "$STAGED_FILES" ]; then
  npx prettier --check $STAGED_FILES
  if [ $? -ne 0 ]; then
    echo "⚠️  Some files are not properly formatted."
    echo "Run 'npx prettier --write <files>' to format them."
    echo "Or use 'git commit --no-verify' to skip these checks."
    # Don't exit - just warn
  fi
fi

# 3. Run ESLint in check mode (no auto-fix)
echo "🔍 Running ESLint checks..."
if [ ! -z "$STAGED_TS_FILES" ]; then
  ACTIVE_TS_FILES=$(echo "$STAGED_TS_FILES" | grep -E '^(packages/asset-browser|packages/core/(components|types|utils)|packages/core/index\.ts)' || true)
  if [ ! -z "$ACTIVE_TS_FILES" ]; then
    npx eslint --max-warnings 100 $ACTIVE_TS_FILES
  fi
  if [ $? -ne 0 ]; then
    echo "⚠️  ESLint found issues. Consider fixing them."
    echo "Run 'npx eslint --fix <files>' to auto-fix some issues."
    # Don't exit - just warn
  fi
fi

# 4. Check for large files
echo "📦 Checking file sizes..."
LARGE_FILES=$(git diff --cached --name-only --diff-filter=ACM | xargs -I {} sh -c 'if [ -f "{}" ] && [ $(wc -c < "{}") -gt 1048576 ]; then echo "{}"; fi' || true)

if [ ! -z "$LARGE_FILES" ]; then
  echo "⚠️  Large files detected (>1MB):"
  echo "$LARGE_FILES"
  echo "Consider using Git LFS for large files."
fi

# 5. Security check - look for potential secrets
echo "🔐 Checking for potential secrets..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ ! -z "$STAGED_FILES" ]; then
  # Simple patterns for common secrets
  PATTERNS="(api[_-]?key|password|secret|token|private[_-]?key|aws[_-]?access|auth)"
  
  for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
      if grep -iE "$PATTERNS\s*[:=]\s*['\"][^'\"]{10,}['\"]" "$file" > /dev/null 2>&1; then
        echo "⚠️  Potential secret found in: $file"
        echo "Please review and remove any sensitive information."
      fi
    fi
  done
fi

echo "✅ Pre-commit checks complete!"
echo ""
echo "💡 Tips:"
echo "  - Use 'git commit --no-verify' to skip these checks"
echo "  - Run 'npm run lint:fix' to auto-fix many issues"
echo "  - Run 'npm run format' to format all files"