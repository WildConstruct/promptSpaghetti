# Environment Configuration

# Development/Production mode
NODE_ENV=development

# Feature flags
ENABLE_CORRECTIONS=true
REACT_APP_ENABLE_CORRECTIONS=true

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Error tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics
VITE_ANALYTICS_ID=

# Build configuration
VITE_BUILD_VERSION=0.1.0-alpha
VITE_BUILD_TIMESTAMP=

# Cache configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000

# Security
VITE_ENABLE_CSP=true
VITE_TRUSTED_DOMAINS=localhost,127.0.0.1

# Debugging
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/oauth/callback/github

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/oauth/callback/microsoft

# OAuth General Settings
OAUTH_STATE_SECRET=your-oauth-state-secret-key-at-least-32-characters
OAUTH_SESSION_TIMEOUT=3600
OAUTH_ENABLED=true