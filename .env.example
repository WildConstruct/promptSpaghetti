# Environment Configuration

# Development/Production mode
NODE_ENV=development

# Feature flags
ENABLE_CORRECTIONS=true
REACT_APP_ENABLE_CORRECTIONS=true

# API Configuration
# Preferred by current client code
VITE_API_URL=http://localhost:8000
# Backward-compat alias retained for older scripts/docs
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# LLM Service Configuration (OpenRouter)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODE=development
LLM_DAILY_LIMIT=100
LLM_COST_LIMIT=0.10
LLM_CACHE_ENABLED=true
ENABLE_MODEL_INTERPRETATION=true

# PSG image bootstrap / preview vendors
# Preview generation (Krea)
KREA_API_TOKEN=
KREA_BASE_URL=https://api.krea.ai
KREA_DEFAULT_STEPS=28
KREA_DEFAULT_STRENGTH=0.75
KREA_GUIDANCE_SCALE=7.5
KREA_NEGATIVE_PROMPT=blurry, deformed, extra limbs, watermark
KREA_POLL_ATTEMPTS=20
KREA_POLL_INTERVAL_MS=2000

# Segmentation (Replicate)
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com/v1
# Prefer model slug if you want Replicate to resolve the latest model endpoint directly.
REPLICATE_SEGMENTATION_MODEL=
# Or provide a pinned version for deterministic behavior.
# Defaults in code to meta/sam-2:
# fe97b453a6455861e3bac769b441ca1f1086110da7466dbb65cf1eecfd60dc83
REPLICATE_SEGMENTATION_VERSION=
# Most models use "image"; override if your chosen Replicate model expects a different key.
REPLICATE_SEGMENTATION_IMAGE_INPUT_KEY=image
REPLICATE_SEGMENTATION_POLL_ATTEMPTS=20
REPLICATE_SEGMENTATION_POLL_INTERVAL_MS=1500

# Performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Error tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics
VITE_ANALYTICS_ID=

# Build configuration
VITE_BUILD_VERSION=0.1.0-alpha
VITE_BUILD_TIMESTAMP=

# Cache configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000

# Security
VITE_ENABLE_CSP=true
VITE_TRUSTED_DOMAINS=localhost,127.0.0.1

# Debugging
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=PLACEHOLDER_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=PLACEHOLDER_GOOGLE_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=PLACEHOLDER_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=PLACEHOLDER_GITHUB_SECRET
GITHUB_REDIRECT_URI=http://localhost:8000/auth/oauth/callback/github

# Microsoft OAuth
MICROSOFT_CLIENT_ID=PLACEHOLDER_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=PLACEHOLDER_MICROSOFT_SECRET
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/oauth/callback/microsoft

# OAuth General Settings
OAUTH_STATE_SECRET=PLACEHOLDER_SECRET_KEY_REPLACE_IN_PRODUCTION
OAUTH_SESSION_TIMEOUT=3600
OAUTH_ENABLED=true

# Supabase (Storage for .psg)
# IMPORTANT: These are PUBLIC values, not secrets. They are safe to expose.
# Security is handled through Row Level Security (RLS) policies in Supabase.
# See: https://supabase.com/docs/guides/auth/row-level-security
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Feature flags for Supabase integration
NEXT_PUBLIC_FEATURE_SUPABASE=1   # set 0 to disable Supabase features globally
NEXT_PUBLIC_FEATURE_DEV_USER=0   # set 1 to enable local dev userId stub
## Notes:
## - The Supabase URL and anon key are intentionally public values
## - Security is enforced via RLS policies, not by hiding these values
## - See docs/setup/supabase-storage.md for bucket setup and policy examples.
